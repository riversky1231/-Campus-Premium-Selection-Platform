<view class="wrap"><view class="eyebrow">MY ORDERS</view><view class="row"><view class="title">我的订单</view><text bindtap="logout" class="muted">退出登录</text></view><view class="card"><view class="row"><view class="label">账户余额</view><view class="price">¥{{balance}}</view></view><view class="stock">余额不足时请联系管理员充值，支付为模拟余额扣款。</view></view><button class="secondary" bindtap="cart">返回购物车</button><view wx:if="{{!orders.length}}" class="empty">还没有订单，去挑选好物吧</view><view wx:for="{{orders}}" wx:key="id" class="card"><view class="row"><view class="name">{{item.label}}</view><view class="muted">{{item.createdAt}}</view></view><view wx:for="{{item.items}}" wx:for-item="line" wx:key="product_id" class="stock">{{line.product_name}} × {{line.quantity}}</view><view class="price">¥{{item.amount}}</view><view class="stock">收货：{{item.recipient}} {{item.phone}} {{item.address}}</view><view wx:if="{{item.status==='PAID'||item.status==='COMPLETED'}}" class="stock">提货码：{{item.pickupCode}}</view><view wx:if="{{item.status==='PENDING'}}" class="row"><button bindtap="pay" data-id="{{item.id}}" loading="{{busy}}" disabled="{{busy}}">立即支付</button><button class="secondary" bindtap="cancel" data-id="{{item.id}}">取消订单</button></view></view></view>
