<view class="wrap" wx:if="{{product}}"><view class="eyebrow">CAMPUS SELECTION</view><view class="art" style="height:400rpx;font-size:160rpx">{{product.categoryId==1?'🥨':product.categoryId==2?'🍋':'🧺'}}</view><view class="title">{{product.name}}</view><view class="price">¥{{product.price}}</view><view class="stock">剩余 {{product.stock}} 件 · 校园自提</view><view class="card" style="margin-top:32rpx">{{product.description}}</view><view class="label">购买数量</view><slider min="1" max="{{product.stock>99?99:product.stock||1}}" value="{{quantity}}" show-value="true" bindchange="quantity" activeColor="#254e3b"/><button bindtap="add" loading="{{busy}}" disabled="{{busy||product.stock==0}}">{{product.stock==0?'暂时售罄':'加入购物车'}}</button></view><view wx:if="{{error}}" class="wrap"><button bindtap="retry">重新加载</button></view>
