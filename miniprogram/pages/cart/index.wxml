<view class="wrap"><view class="eyebrow">CART</view><view class="title">购物车</view><view wx:if="{{!items.length}}" class="empty">购物车还是空的，去挑选好物吧</view><view wx:for="{{items}}" wx:key="product.id" class="card"><view class="row"><view><view class="name">{{item.product.name}}</view><view class="price">¥{{item.product.price}}</view></view><view class="row"><button class="secondary" data-id="{{item.product.id}}" data-delta="{{-1}}" bindtap="change">－</button><text>{{item.quantity}}</text><button class="secondary" data-id="{{item.product.id}}" data-delta="{{1}}" bindtap="change">＋</button></view></view></view><view class="price">合计 ¥{{total}}</view><view class="label">收货地址</view><view wx:for="{{addresses}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="pick"><view class="row"><view><view class="name">{{item.recipient}} {{item.phone}}</view><view class="stock">{{item.detail}}</view></view><text class="chip {{addressId==item.id?'active':''}}">{{addressId==item.id?'已选':'选择'}}</text></view></view><view class="card"><view class="label">新增地址</view><input placeholder="收货人（1-40字）" value="{{form.recipient}}" data-field="recipient" bindinput="field"/><input placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="field"/><input placeholder="自提点与楼栋" value="{{form.detail}}" data-field="detail" bindinput="field"/><button class="secondary" bindtap="addAddress">保存地址</button></view><button bindtap="checkout" loading="{{busy}}" disabled="{{busy||!items.length}}">提交订单</button><button class="secondary" bindtap="orders">查看我的订单</button></view>
