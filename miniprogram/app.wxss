page{background:#f5f3e9;color:#243f33;font-family:"PingFang SC",sans-serif;font-size:28rpx}.wrap{padding:32rpx}.eyebrow{font-size:22rpx;letter-spacing:6rpx;color:#6d806c}.title{font-size:58rpx;font-weight:800;line-height:1.2;margin:18rpx 0}.muted{color:#778171;font-size:24rpx}.hero{background:#234e3c;color:#fff8dc;padding:44rpx 32rpx;border-radius:8rpx 80rpx 8rpx 8rpx;margin:24rpx 0}.hero .muted{color:#d4ddc5}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.chips{white-space:nowrap;margin:24rpx 0}.chip{display:inline-block;padding:16rpx 26rpx;background:#e8e9db;border-radius:40rpx;margin-right:14rpx}.active{background:#d4e57c}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.card{background:#fffdf6;padding:22rpx;border-radius:12rpx;margin-bottom:20rpx}.art{height:160rpx;display:flex;align-items:center;justify-content:center;background:#e5e9d2;font-size:84rpx;border-radius:8rpx;margin-bottom:20rpx}.name{font-size:30rpx;font-weight:600}.price{color:#a7492a;font-size:36rpx;font-weight:700;margin-top:18rpx}button{background:#254e3b;color:#fff9e5;border-radius:8rpx;font-size:28rpx;margin:20rpx 0}button.secondary{background:#e4e8d6;color:#254e3b}input,textarea,picker{background:white;padding:22rpx;border-radius:8rpx;margin:12rpx 0 24rpx;box-sizing:border-box;width:100%}.label{font-size:24rpx;color:#61765e}.empty{padding:60rpx 20rpx;text-align:center;color:#778171}.stock{font-size:23rpx;color:#6b7a62;margin-top:10rpx}.footer{margin:40rpx 0;color:#7b8471;font-size:22rpx}
