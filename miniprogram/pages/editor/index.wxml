<view class="wrap"><view class="eyebrow">CATALOG / EDITOR</view><view class="title">{{id?'编辑好物':'上新一件好物'}}</view><view class="label">商品名称</view><input value="{{name}}" data-field="name" bindinput="field" maxlength="100"/><view class="label">分类</view><picker range="{{categories}}" range-key="name" value="{{index}}" bindchange="category">{{categories[index].name||'请先创建分类'}} ▾</picker><view class="label">价格 / 元</view><input type="digit" value="{{price}}" data-field="price" bindinput="field"/><view wx:if="{{!id}}"><view class="label">初始库存</view><input type="number" value="{{stock}}" data-field="stock" bindinput="field"/></view><view class="label">商品说明</view><textarea value="{{description}}" maxlength="1000" data-field="description" bindinput="field"/><view class="row"><text>立即上架</text><switch checked="{{onSale}}" bindchange="sale" color="#254e3b"/></view><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存商品</button></view>
