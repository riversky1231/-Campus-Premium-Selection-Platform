<view class="wrap"><view class="eyebrow">ACCOUNT</view><view class="title">{{mode==='login'?'登录':'注册新账号'}}</view><view class="label">账号</view><input placeholder="4-32位字母、数字或下划线" value="{{username}}" data-field="username" bindinput="field"/><view class="label">密码</view><input password="true" placeholder="8-64位" value="{{password}}" data-field="password" bindinput="field"/><block wx:if="{{mode==='register'}}"><view class="label">昵称</view><input placeholder="1-60个字符" value="{{nickname}}" data-field="nickname" bindinput="field"/></block><button bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{mode==='login'?'登录':'注册并登录'}}</button><button class="secondary" bindtap="toggle">{{mode==='login'?'没有账号？去注册':'已有账号？去登录'}}</button></view>
